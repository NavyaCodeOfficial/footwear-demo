{
  "name": "royal-footwear",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "type": "module",
  "description": "Royal Footwear storefront (demo) by NavyaCode",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "vite-react-ssg dev",
    "build": "tsc --noEmit && vite-react-ssg build && node scripts/generate-seo-files.mjs && node scripts/verify-build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "images:demo": "node scripts/generate-demo-images.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "vite-react-ssg": "0.9.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
